#include "system.h"
#include "altera_avalon_pio_regs.h"
#include "unistd.h"
#include <stdio.h>

unsigned int time = 500000;  // microsecondes

int main(void)
{
    printf("Hello, world !\r\n");

    while (1)
    {
        IOWR_ALTERA_AVALON_PIO_DATA(PIO_0_BASE, 1);
        alt_usleep(time);

        IOWR_ALTERA_AVALON_PIO_DATA(PIO_0_BASE, 0);
        alt_usleep(time);
    }

    return 0;
}
