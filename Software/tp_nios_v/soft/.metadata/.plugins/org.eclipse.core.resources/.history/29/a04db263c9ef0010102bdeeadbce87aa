//lecture d'angle
float read_angle(void)
{
    static float angle = -45.0f;
    angle += 5.0f;
    if (angle > 45.0f)
        angle = -45.0f;
    return angle;
}

unsigned int angle_to_led(float angle)
{
    int led_index;

    if (angle > 45.0f)  angle = 45.0f;
    if (angle < -45.0f) angle = -45.0f;

    led_index = (int)((angle + 45.0f) * 9.0f / 90.0f);

    return (1 << led_index);
}

int main(void)
{
    float angle;
    unsigned int leds;

    printf("Niveau a bulles demarre\r\n");

    while (1)
    {
        angle = read_angle();           // capteur inclinaison
        leds = angle_to_led(angle);     // conversion angle → LED

        IOWR_ALTERA_AVALON_PIO_DATA(PIO_0_BASE, leds);

        usleep(DELAY_US);
    }

    return 0;
}
