#include <stdio.h>
#include <math.h>
#include <unistd.h>
#include "system.h"
#include "altera_avalon_pio_regs.h"
#include "altera_avalon_i2c.h"

// Adresse I2C de l'ADXL345
#define ADXL345_ADDR       0x53
#define ADXL345_DEVID      0x00
#define ADXL345_POWER_CTL  0x2D
#define ADXL345_DATA_START 0x32

#define DELAY_US 200000   // 200 ms

// Nombre de LEDs disponibles
#define NUM_LEDS PIO_0_DATA_WIDTH  // ajuster selon ton PIO

ALT_AVALON_I2C_DEV_t *i2c_dev;

// Fonction pour lire les axes
void adxl345_read_axes(ALT_AVALON_I2C_DEV_t *i2c_dev, float *x_g, float *y_g, float *z_g) {
    uint8_t txbuffer[1] = {ADXL345_DATA_START};
    uint8_t rxbuffer[6];

    alt_avalon_i2c_master_target_set(i2c_dev, ADXL345_ADDR);
    alt_avalon_i2c_master_tx_rx(i2c_dev, txbuffer, 1, rxbuffer, 6, ALT_AVALON_I2C_NO_INTERRUPTS);

    int16_t x = (rxbuffer[1] << 8) | rxbuffer[0];
    int16_t y = (rxbuffer[3] << 8) | rxbuffer[2];
    int16_t z = (rxbuffer[5] << 8) | rxbuffer[4];

    // Conversion en g (sensibilité ±2g -> 256 LSB/g)
    *x_g = x / 256.0f;
    *y_g = y / 256.0f;
    *z_g = z / 256.0f;
}

// Convertit une inclinaison (-90°..+90°) en LED (0..NUM_LEDS-1)
unsigned int angle_to_led(float angle) {
    float clamped = fmaxf(fminf(angle, 45.0f), -45.0f); // limiter à ±45°
    int led = (int)((clamped + 45.0f) / 90.0f * (NUM_LEDS - 1));
    return 1 << led; // LED correspondante
}

int main(void) {
    printf("Niveau a bulles demarre\r\n");

    // Initialisation I2C
    i2c_dev = alt_avalon_i2c_open("/dev/I2C_0");
    alt_avalon_i2c_master_target_set(i2c_dev, ADXL345_ADDR);

    // Activer le mode mesure
    uint8_t txbuffer[2] = {ADXL345_POWER_CTL, 0x08};
    alt_avalon_i2c_master_tx(i2c_dev, txbuffer, 2, ALT_AVALON_I2C_NO_INTERRUPTS);

    while (1) {
        float x, y, z;
        adxl345_read_axes(i2c_dev, &x, &y, &z);

        // Calcul de l'inclinaison X et Y par rapport à Z
        float tilt_x = atan2f(x, z) * 180.0f / 3.14159265f;
        float tilt_y = atan2f(y, z) * 180.0f / 3.14159265f;

        // Affichage
        printf("X=%.3fg Y=%.3fg Z=%.3fg TiltX=%.1f° TiltY=%.1f°\n", x, y, z, tilt_x, tilt_y);

        // Conversion angle -> LED
        unsigned int led_y = angle_to_led(tilt_y);


        IOWR_ALTERA_AVALON_PIO_DATA(PIO_0_BASE, led_y); // LEDs Y

        usleep(DELAY_US);
    }

    return 0;
}

